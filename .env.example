# Firebase web configuration (Vite exposes only VITE_-prefixed vars to the client).
# Copy this file to `.env` and fill in your project's values from the Firebase
# console (Project settings → General → Your apps → SDK setup and configuration).
# Without these, the app transparently falls back to the mock auth backend.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
# Optional — enables Analytics when present.
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Gemini (AI diagnosis assistant for doctors).
# NOTE: this app runs client-side, so the key ships in the browser bundle — use
# a key with cost limits for demos only, never a production/usage key.
# Get a free key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# Optional — default is gemini-2.0-flash.
# VITE_GEMINI_MODEL=gemini-2.0-flash
