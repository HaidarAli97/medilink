rules_version = '2';

// MediLink Firestore Security Rules
// ----------------------------------
// Identity is the authenticated Firebase UID (request.auth.uid). Firestore
// stores user profiles at users/{uid} and appointments at appointments/{id}.
// Roles are: "patient" | "doctor" | "admin", read from the requester's own
// profile document — never trusted from client input.
//
// The remaining clinic data (patients, doctors, medicalRecords, prescriptions)
// still lives in the in-memory demo layer, so those paths are denied by default
// (final catch-all). When a collection is migrated later, add one role-aware
// match block for it (sketch at the bottom of this file); do not relax the
// catch-all.
//
// Access model:
//   - READ    a profile: the owner, or any admin. (Non-admins cannot list or
//             read other users, so no patient can see another patient's data.)
//   - CREATE  a profile: only your OWN doc, only as "patient", never pre-linked
//             to a clinical record. Covers self-registration and self-heal.
//   - UPDATE  a profile: admins may change anything (this is how doctor/admin
//             roles are provisioned). A non-admin owner may edit only display
//             fields — never role, uid, email, or linkedId (the authorization
//             link that decides which records they can see).
//   - DELETE  a profile: admins only.
//
// Bootstrapping the first admin: no admin exists initially, so create the first
// admin's users/{uid} document directly in the Firebase console (console writes
// bypass these rules). NOTE: if that admin signed in BEFORE its doc existed,
// self-heal created a "patient" doc for it — fix it in the console by setting
// role to "admin". After that, admins can provision other doctors/admins.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Does the signed-in user have a profile document at all?
    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // The role stored on the requester's OWN profile (server-side source of truth).
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return hasProfile() && myRole() == 'admin';
    }

    function isDoctor() {
      return hasProfile() && myRole() == 'doctor';
    }

    // The linkedId on the requester's OWN profile — the id of the clinical
    // record (patients/{id} or doctors/{id}) they act as. Authorization link.
    function myLinkedId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedId;
    }

    // ---- user profiles: users/{uid} ------------------------------------
    match /users/{uid} {

      // Read: owner reads own profile; admins read any. Non-admins can neither
      // read another user's doc nor list the collection.
      allow read: if isOwner(uid) || isAdmin();

      // Create: only your own doc, only as a patient, never pre-linked, and only
      // the known profile fields (no field injection). Self-signup and self-heal
      // both satisfy this; doctor/admin can never be self-assigned.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['uid', 'fullName', 'email', 'role', 'phone', 'profileImage', 'createdAt', 'linkedId'])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'patient'
        && request.resource.data.linkedId == null;

      // Update: admins may change anything (incl. role/linkedId — this is how
      // roles are provisioned). A non-admin owner may edit only display fields;
      // role, uid, email and linkedId must be unchanged, so a client can never
      // escalate its role or re-point itself at another user's records.
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.role == resource.data.role
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.email == resource.data.email
            && request.resource.data.linkedId == resource.data.linkedId);

      // Delete: admins only.
      allow delete: if isAdmin();
    }

    // ---- appointments: appointments/{id} -------------------------------
    // The only clinical collection in Firestore. Each doc stores patientId /
    // doctorId (the mock ids), matched against the requester's linkedId. Reads
    // are scoped so a patient sees only their own appointments and a doctor only
    // theirs — client queries MUST filter to match (rules are not filters).
    match /appointments/{id} {

      // Read: admins all; a doctor their own; a patient their own.
      allow read: if isAdmin()
        || (isDoctor()   && resource.data.doctorId  == myLinkedId())
        || (isSignedIn() && resource.data.patientId == myLinkedId());

      // Create: a patient books for themselves; an admin books for anyone.
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.patientId == myLinkedId());

      // Update: admins anything; a doctor manages their own appointments; a
      // patient may update their own (e.g. cancel).
      allow update: if isAdmin()
        || (isDoctor()   && resource.data.doctorId  == myLinkedId())
        || (isSignedIn() && resource.data.patientId == myLinkedId());

      // Delete: admins only (used by the patient/doctor removal cascade).
      allow delete: if isAdmin();
    }

    // ---- default deny --------------------------------------------------
    // Remaining clinic collections (patients, doctors, medicalRecords,
    // prescriptions) still live in the in-memory demo layer, not Firestore.
    // Everything not explicitly matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ---------------------------------------------------------------------------
// FUTURE (do NOT enable until that collection is actually migrated to Firestore):
// appointments are live above. If medical records move server-side later, add a
// role-aware block mirroring the appointments one, e.g.:
//
//   match /medicalRecords/{id} {
//     allow read: if isAdmin()
//       || (isDoctor()   && resource.data.doctorId  == myLinkedId())
//       || (isSignedIn() && resource.data.patientId == myLinkedId());
//     allow write: if isAdmin() || (isDoctor() && resource.data.doctorId == myLinkedId());
//   }
// ---------------------------------------------------------------------------
